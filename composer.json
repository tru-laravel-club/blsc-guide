{
    "name": "tru-laravel-club/blsc-guide",
    "description": "A step-by-step contributor guide for the BIG Little Science Centre website. Install it as a dev dependency only.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "guide",
        "education"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/process": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7|^5.0"
    },
    "autoload": {
        "psr-4": {
            "TruLaravelClub\\BlscGuide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TruLaravelClub\\BlscGuide\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TruLaravelClub\\BlscGuide\\GuideServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "types:check": [
            "@php -d memory_limit=512M vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@types:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
